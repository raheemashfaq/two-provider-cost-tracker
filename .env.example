# Copy to .env and fill in real keys. Never commit .env.
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here

# Models and prices (USD per 1M tokens) - check the pricing pages
GEMINI_MODEL=gemini-3.8-flash
GEMINI_INPUT_PRICE_PER_M=0.75
GEMINI_OUTPUT_PRICE_PER_M=3.75
GROQ_MODEL=openai/gpt-oss-20b
GROQ_INPUT_PRICE_PER_M=0.075
GROQ_OUTPUT_PRICE_PER_M=0.30
